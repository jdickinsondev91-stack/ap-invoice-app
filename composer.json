{
    "name": "ap-invoices/app",
    "description": "AP Invoices Application - Framework X/ReactPHP",
    "type": "project",
    "require": {
        "php": "^8.0",
        "clue/framework-x": "^0.17",
        "react/mysql": "0.7.x-dev",
        "react/async": "^4"
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}